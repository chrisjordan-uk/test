# Copy this file to .env and fill in your own values.
# Never commit your real .env file or API key.

# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which Gemini model to use for image editing.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BACKOFF_SECONDS=2.0
GEMINI_MAX_UPLOAD_DIMENSION=1536

# Minimum image-similarity score (0-1) between the original and the
# Gemini-edited photo for the edit to be trusted. Below this, the original
# image is kept instead and the result is flagged "unsafe" in the report.
GEMINI_MIN_SIMILARITY=0.55

# --- Upload limits ---------------------------------------------------------
MAX_ZIP_SIZE_MB=100
MAX_PRODUCT_FOLDERS=60
MAX_IMAGES_PER_FOLDER=20
MAX_IMAGE_FILE_SIZE_MB=15
MAX_TOTAL_IMAGES=200

# --- Default processing settings (changeable per batch in the UI) ----------
DEFAULT_USE_GEMINI=true
DEFAULT_USE_LOCAL_ENHANCEMENT=true
DEFAULT_JPEG_QUALITY=88
DEFAULT_MAX_DIMENSION=1600
